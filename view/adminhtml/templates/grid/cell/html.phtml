<?php
declare(strict_types=1);

use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;

/** @version 0.9.2 */
/** @var Escaper $escaper */
/** @var Template $block */
$value = $block->getValue();
$emptyValue = $block->getEmptyValue();

if (empty($value) && !empty($emptyValue)) {
    $value = $emptyValue;
}

if (is_array($value)) {
    $value = 'array';
}

if (is_object($value)) {
    $value = 'object';
}
?>
<?= $escaper->escapeHtml(
    (string)$value,
    ['a', 'b', 'br', 'code', 'em', 'i', 'li', 'ol', 'p', 'small', 'span', 'strong', 'u', 'ul']
) ?>
