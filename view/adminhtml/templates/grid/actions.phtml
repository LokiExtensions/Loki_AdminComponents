<?php
declare(strict_types=1);

/** @version 0.7.2 */

use Magento\Framework\View\Element\Template;
use Loki\AdminComponents\Component\Grid\GridViewModel;
use Loki\Components\Util\Block\TemplateRenderer;

/** @var Template $block */
/** @var GridViewModel $viewModel */
/** @var TemplateRenderer $templateRenderer */

$viewModel = $block->getViewModel();
$buttons = $viewModel->getButtons();
?>
<div class="<?= $escaper->escapeHtml($css('page-main-actions', '@todo')) ?>">
    <div class="<?= $escaper->escapeHtml($css('page-actions', '@todo')) ?>">
        <div class="<?= $escaper->escapeHtml($css('page-actions-inner', '@todo')) ?>">
            <div class="<?= $escaper->escapeHtml($css('page-actions-buttons', '@todo')) ?>">
                <?php foreach ($buttons as $button): ?>
                    <?= /* @noEscape */ $templateRenderer->html(
                        $block,
                        'Loki_AdminComponents::ui/button.phtml',
                        ['button' => $button]
                    ) ?>
                <?php endforeach; ?>
            </div>
        </div>
    </div>
</div>
